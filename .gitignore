# ==========================================
# Nyxora - Comprehensive Project .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Production & Build outputs
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Environment & Secrets (NEVER commit real API keys)
.env
.env.local
.env.*.local
*.env
!.env.example

# Android & Gradle (frontend/android)
.gradle/
**/android/.gradle/
**/android/local.properties
captures/
.externalNativeBuild/
.cxx/

# Compiled Mobile Packages
*.apk
*.aab

# Android Keystores & Signing
*.jks
*.keystore
*.p12
*.key
*.pem
signing.properties

# IDE & Editor Configuration
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
